const VAR_ESTADO_TRIGGER      = VAR_TEMP_1
const VAR_CONTADOR_CHARLAS    = VAR_TEMP_2
const VAR_PUZZLE_BITMASK      = VAR_TEMP_3
const VAR_SECUENCIA_ORDEN     = VAR_TEMP_4
const VAR_RACHA_COMBATES      = VAR_TEMP_5
const VAR_CLIMA_ACTUAL        = VAR_TEMP_6

mapscripts A0_Inicio_2_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        if (var(VAR_PUZZLE_BITMASK) == 7) {
            call(A0_Inicio_2_Script_AplicarPuzzleResuelto)
        }
    }
}

script(global) A0_Inicio_2_EventScript_NpcKitPruebas {
    lock
    faceplayer

    if (flag(FLAG_SYS_POKEMON_GET) == TRUE) {
        msgbox(Text_KitYaActivo, MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES) {
            call(A0_Inicio_2_Script_CurarEquipoConEfecto)
            msgbox("Equipo curado y PP restaurados!", MSGBOX_DEFAULT)
        }
        release
        end
    }

    msgbox(Text_KitBienvenida, MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        msgbox("Avisame cuando quieras activar el kit.", MSGBOX_DEFAULT)
        release
        end
    }

    message("Elige tu Pokemon de pruebas:")
    waitmessage
    dynmultichoice(15, 2, TRUE, 3, 0, DYN_MULTICHOICE_CB_NONE,
        "Mudkip (Nv.15)",
        "Treecko (Nv.15)",
        "Torchic (Nv.15)"
    )
    closemessage

    switch (var(VAR_RESULT)) {
        case 0:
            givemon(SPECIES_MUDKIP, 15, ITEM_ORAN_BERRY)
        case 1:
            givemon(SPECIES_TREECKO, 15, ITEM_ORAN_BERRY)
        default:
            givemon(SPECIES_TORCHIC, 15, ITEM_ORAN_BERRY)
    }

    setflag(FLAG_SYS_POKEMON_GET)
    setflag(FLAG_SYS_POKEDEX_GET)
    setflag(FLAG_SYS_B_DASH)

    playfanfare(MUS_OBTAIN_ITEM)
    msgbox("Kit activado! Recibiste tu Pokemon,\nPokedex y Zapatillas Deportivas.", MSGBOX_DEFAULT)
    waitfanfare

    giveitem(ITEM_POKE_BALL, 10)
    giveitem(ITEM_SUPER_POTION, 5)
    giveitem(ITEM_RARE_CANDY, 5)

    release
    end
}

script(global) A0_Inicio_2_EventScript_NpcContador {
    lock
    faceplayer

    addvar(VAR_CONTADOR_CHARLAS, 1)
    buffernumberstring(STR_VAR_1, VAR_CONTADOR_CHARLAS)

    switch (var(VAR_CONTADOR_CHARLAS)) {
        case 1:
            msgbox("Primera charla ({STR_VAR_1}).\nVAR_TEMP_2 se mantendra mientras\nno salgas de A0_Inicio_2.", MSGBOX_DEFAULT)
        case 3:
            msgbox("Llevas {STR_VAR_1} charlas. Sigue asi!", MSGBOX_DEFAULT)
        case 5:
            msgbox("Hito de {STR_VAR_1} charlas alcanzado!\nToma una Superpocion de regalo.", MSGBOX_DEFAULT)
            giveitem(ITEM_SUPER_POTION, 1)
        case 10:
            msgbox("Limite de {STR_VAR_1} alcanzado.\nReiniciando contador a 0.", MSGBOX_DEFAULT)
            setvar(VAR_CONTADOR_CHARLAS, 0)
        default:
            msgbox("Contador actual: {STR_VAR_1} / 10.", MSGBOX_DEFAULT)
    }

    release
    end
}

script(global) A0_Inicio_2_EventScript_CartelMenu {
    lockall
    message("Panel de control de A0_Inicio_2.\nSelecciona una herramienta:")
    waitmessage

    dynmultichoice(13, 1, FALSE, 5, 0, DYN_MULTICHOICE_CB_NONE,
        "Curar equipo",
        "Clima: Lluvia",
        "Clima: Tormenta Arena",
        "Clima: Despejado",
        "Resetear VAR_TEMP"
    )
    closemessage

    switch (var(VAR_RESULT)) {
        case 0:
            call(A0_Inicio_2_Script_CurarEquipoConEfecto)
            msgbox("Equipo curado al maximo!", MSGBOX_DEFAULT)
        case 1:
            setvar(VAR_CLIMA_ACTUAL, WEATHER_RAIN)
            setweather(WEATHER_RAIN)
            doweather
            msgbox("Clima cambiado a lluvia.", MSGBOX_DEFAULT)
        case 2:
            setvar(VAR_CLIMA_ACTUAL, WEATHER_SANDSTORM)
            setweather(WEATHER_SANDSTORM)
            doweather
            msgbox("Clima cambiado a tormenta de arena.", MSGBOX_DEFAULT)
        case 3:
            setvar(VAR_CLIMA_ACTUAL, WEATHER_NONE)
            setweather(WEATHER_NONE)
            doweather
            msgbox("Clima despejado.", MSGBOX_DEFAULT)
        case 4:
            setvar(VAR_ESTADO_TRIGGER, 0)
            setvar(VAR_CONTADOR_CHARLAS, 0)
            setvar(VAR_PUZZLE_BITMASK, 0)
            setvar(VAR_SECUENCIA_ORDEN, 0)
            setvar(VAR_RACHA_COMBATES, 0)
            playse(SE_PC_OFF)
            msgbox("Todas las variables temporales\ndel mapa han vuelto a 0.", MSGBOX_DEFAULT)
    }

    releaseall
    end
}

script(global) A0_Inicio_2_EventScript_TriggerAviso {
    lockall
    playse(SE_PIN)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(emote_exclamation_mark))
    waitmovement(0)

    msgbox("Has activado el Coord Event!\nVAR_TEMP_1 pasa a valer 1,\nasi que no volvera a saltar.", MSGBOX_DEFAULT)

    setvar(VAR_ESTADO_TRIGGER, 1)
    releaseall
    end
}

script(global) A0_Inicio_2_EventScript_InterruptorA {
    lock
    if (var(VAR_PUZZLE_BITMASK) == 1 || var(VAR_PUZZLE_BITMASK) == 3 || var(VAR_PUZZLE_BITMASK) == 5 || var(VAR_PUZZLE_BITMASK) == 7) {
        msgbox("El interruptor A ya esta encendido.", MSGBOX_DEFAULT)
    } else {
        addvar(VAR_PUZZLE_BITMASK, 1)
        playse(SE_SWITCH)
        msgbox("Interruptor A activado!", MSGBOX_DEFAULT)
        call(A0_Inicio_2_Script_VerificarBitmask)
    }
    release
    end
}

script(global) A0_Inicio_2_EventScript_InterruptorB {
    lock
    if (var(VAR_PUZZLE_BITMASK) == 2 || var(VAR_PUZZLE_BITMASK) == 3 || var(VAR_PUZZLE_BITMASK) == 6 || var(VAR_PUZZLE_BITMASK) == 7) {
        msgbox("El interruptor B ya esta encendido.", MSGBOX_DEFAULT)
    } else {
        addvar(VAR_PUZZLE_BITMASK, 2)
        playse(SE_SWITCH)
        msgbox("Interruptor B activado!", MSGBOX_DEFAULT)
        call(A0_Inicio_2_Script_VerificarBitmask)
    }
    release
    end
}

script(global) A0_Inicio_2_EventScript_InterruptorC {
    lock
    if (var(VAR_PUZZLE_BITMASK) >= 4) {
        msgbox("El interruptor C ya esta encendido.", MSGBOX_DEFAULT)
    } else {
        addvar(VAR_PUZZLE_BITMASK, 4)
        playse(SE_SWITCH)
        msgbox("Interruptor C activado!", MSGBOX_DEFAULT)
        call(A0_Inicio_2_Script_VerificarBitmask)
    }
    release
    end
}

script A0_Inicio_2_Script_VerificarBitmask {
    if (var(VAR_PUZZLE_BITMASK) == 7) {
        playfanfare(MUS_LEVEL_UP)
        msgbox("Los 3 interruptores estan activos!\nMecanismo desbloqueado.", MSGBOX_DEFAULT)
        waitfanfare
        call(A0_Inicio_2_Script_AplicarPuzzleResuelto)
    }
    return
}

script A0_Inicio_2_Script_AplicarPuzzleResuelto {
    return
}

script(global) A0_Inicio_2_EventScript_CombateRacha {
    lock
    faceplayer

    if (flag(FLAG_SYS_POKEMON_GET) == FALSE) {
        msgbox("Necesitas un Pokemon antes de combatir.\nHabla con el muñeco Regirock!", MSGBOX_DEFAULT)
        release
        end
    }

    buffernumberstring(STR_VAR_1, VAR_RACHA_COMBATES)
    msgbox("Racha actual en la sala: {STR_VAR_1}.\nQuieres iniciar un combate de prueba?", MSGBOX_YESNO)

    if (var(VAR_RESULT) == NO) {
        msgbox("Vuelve cuando quieras entrenar.", MSGBOX_DEFAULT)
        release
        end
    }

    switch (var(VAR_RACHA_COMBATES)) {
        case 0:
            setwildbattle(SPECIES_ZIGZAGOON, 10, ITEM_NONE)
        case 1:
            setwildbattle(SPECIES_ELECTRIKE, 13, ITEM_ORAN_BERRY)
        default:
            setwildbattle(SPECIES_ABSOL, 16, ITEM_SITRUS_BERRY)
    }

    dowildbattle

    specialvar(VAR_RESULT, GetBattleOutcome)
    if (var(VAR_RESULT) == B_OUTCOME_WON) {
        addvar(VAR_RACHA_COMBATES, 1)
        buffernumberstring(STR_VAR_1, VAR_RACHA_COMBATES)

        if (var(VAR_RACHA_COMBATES) >= 3) {
            playfanfare(MUS_OBTAIN_ITEM)
            msgbox("3 victorias seguidas!\nToma una Pepita y reiniciamos racha.", MSGBOX_DEFAULT)
            waitfanfare
            giveitem(ITEM_NUGGET, 1)
            setvar(VAR_RACHA_COMBATES, 0)
        } else {
            msgbox("Victoria! Racha actual: {STR_VAR_1} de 3.", MSGBOX_DEFAULT)
        }
    } else {
        setvar(VAR_RACHA_COMBATES, 0)
        msgbox("Has huido o perdido.\nTu racha vuelve a 0.", MSGBOX_DEFAULT)
    }

    release
    end
}

script A0_Inicio_2_Script_CurarEquipoConEfecto {
    fadescreen(FADE_TO_BLACK)
    playfanfare(MUS_HEAL)
    waitfanfare
    special(HealPlayerParty)
    fadescreen(FADE_FROM_BLACK)
    return
}

text Text_KitBienvenida {
    "Bienvenido al mapa de pruebas!\n"
    "Quieres activar el kit de desarrollo?"
}

text Text_KitYaActivo {
    "Ya tienes tu equipo activo.\n"
    "Quieres curar a tus Pokemon?"
}

// =========================================================
// RECOGIDA DE MATERIALES (asignables a BG Events / muebles)
// =========================================================

script(global) A0_Inicio_2_EventScript_BuscarCable {
    lockall
    if (flag(FLAG_A0_INICIO_2_CABLE_COBRE) == TRUE) {
        msgbox("Ya registraste este cajon.\nNo queda nada util.", MSGBOX_DEFAULT)
        releaseall
        end
    }
    msgbox("Encuentras un cable suelto\ndetras del panel...", MSGBOX_DEFAULT)
    giveitem(ITEM_CABLE_COBRE, 1)
    if (var(VAR_RESULT) == TRUE) {
        setflag(FLAG_A0_INICIO_2_CABLE_COBRE)
    }
    releaseall
    end
}

script(global) A0_Inicio_2_EventScript_BuscarCelda {
    lockall
    if (flag(FLAG_A0_INICIO_2_CELDA_ENERGIA) == TRUE) {
        msgbox("El compartimento de la bateria\nesta vacio.", MSGBOX_DEFAULT)
        releaseall
        end
    }
    msgbox("Hay una pequena bateria encajada\nen la ranura...", MSGBOX_DEFAULT)
    giveitem(ITEM_CELDA_ENERGIA, 1)
    if (var(VAR_RESULT) == TRUE) {
        setflag(FLAG_A0_INICIO_2_CELDA_ENERGIA)
    }
    releaseall
    end
}

// =========================================================
// MESA DE CRAFTEO CON DYNMULTICHOICE
// =========================================================

script(global) A0_Inicio_2_EventScript_MesaCrafteo {
    lockall
    message("Mesa de trabajo.\nQue quieres fabricar?")
    waitmessage

    dynmultichoice(11, 1, FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE,
        "Tarjeta A0",
        "Ver recetas",
        "Salir"
    )
    closemessage

    switch (var(VAR_RESULT)) {
        case 0:
            call(A0_Inicio_2_Script_CraftearTarjeta)
        case 1:
            msgbox(Text_RecetasCrafteo, MSGBOX_DEFAULT)
        default:
            // Opcion "Salir" o pulsar B (MULTI_B_PRESSED)
            break
    }

    releaseall
    end
}

script A0_Inicio_2_Script_CraftearTarjeta {
    checkitem(ITEM_TARJETA_ACCESO, 1)
    if (var(VAR_RESULT) == TRUE) {
        msgbox("Ya fabricaste la Tarjeta A0.", MSGBOX_DEFAULT)
        return
    }

    checkitem(ITEM_CABLE_COBRE, 1)
    if (var(VAR_RESULT) == FALSE) {
        playse(SE_FAILURE)
        msgbox("Falta material: 1x Cable Cobre.", MSGBOX_DEFAULT)
        return
    }

    checkitem(ITEM_CELDA_ENERGIA, 1)
    if (var(VAR_RESULT) == FALSE) {
        playse(SE_FAILURE)
        msgbox("Falta material: 1x Celda Energia.", MSGBOX_DEFAULT)
        return
    }

    checkitemspace(ITEM_TARJETA_ACCESO, 1)
    if (var(VAR_RESULT) == FALSE) {
        playse(SE_FAILURE)
        msgbox("No tienes espacio en la Mochila.", MSGBOX_DEFAULT)
        return
    }

    // Consumir ingredientes y entregar resultado
    playse(SE_SWITCH)
    msgbox("Ensamblando circuito...", MSGBOX_DEFAULT)
    delay(20)

    removeitem(ITEM_CABLE_COBRE, 1)
    removeitem(ITEM_CELDA_ENERGIA, 1)
    giveitem(ITEM_TARJETA_ACCESO, 1)
    return
}

text Text_RecetasCrafteo {
    "RECETAS DISPONIBLES:\n"
 
    "- Tarjeta A0: Cable Cobre + Celda."
}


script(global) A0_Inicio_2_EventScript_TutorUniversal {
    lock
    faceplayer

    if (flag(FLAG_SYS_POKEMON_GET) == FALSE) {
        msgbox("No tienes ningun Pokemon al que\nensenar movimientos.", MSGBOX_DEFAULT)
        release
        end
    }

    msgbox("Soy el Tutor Universal.\nElige un Pokemon de tu equipo.", MSGBOX_DEFAULT)
    special(ChoosePartyMon)

    if (var(VAR_0x8004) == PARTY_NOTHING_CHOSEN) {
        msgbox("Vuelve cuando quieras aprender\nun movimiento nuevo.", MSGBOX_DEFAULT)
        release
        end
    }

    specialvar(VAR_RESULT, ScriptGetPartyMonSpecies)
    if (var(VAR_RESULT) == SPECIES_EGG) {
        msgbox("Un Huevo no puede aprender\nmovimientos todavia.", MSGBOX_DEFAULT)
        release
        end
    }

    // VAR_0x8005: tipo elegido (0-17), 100 = buscando, 101 = cancelado
    // VAR_0x8006: pagina actual (0, 1, 2)
    setvar(VAR_0x8005, 100)
    setvar(VAR_0x8006, 0)

    while (var(VAR_0x8005) == 100) {
        message("Que tipo de ataque buscas?")
        waitmessage

        switch (var(VAR_0x8006)) {
            case 0:
                dynmultichoice(13, 1, FALSE, 7, 0, DYN_MULTICHOICE_CB_NONE,
                    "Normal", "Fuego", "Agua", "Planta", "Electrico", "Hielo", "Mas tipos...")
                closemessage
                if (var(VAR_RESULT) == MULTI_B_PRESSED) {
                    setvar(VAR_0x8005, 101)
                } elif (var(VAR_RESULT) == 6) {
                    setvar(VAR_0x8006, 1)
                } else {
                    copyvar(VAR_0x8005, VAR_RESULT)
                }
            case 1:
                dynmultichoice(13, 1, FALSE, 7, 0, DYN_MULTICHOICE_CB_NONE,
                    "Lucha", "Veneno", "Tierra", "Volador", "Psiquico", "Bicho", "Mas tipos...")
                closemessage
                if (var(VAR_RESULT) == MULTI_B_PRESSED) {
                    setvar(VAR_0x8005, 101)
                } elif (var(VAR_RESULT) == 6) {
                    setvar(VAR_0x8006, 2)
                } else {
                    copyvar(VAR_0x8005, VAR_RESULT)
                    addvar(VAR_0x8005, 6)
                }
            default:
                dynmultichoice(13, 1, FALSE, 7, 0, DYN_MULTICHOICE_CB_NONE,
                    "Roca", "Fantasma", "Dragon", "Siniestro", "Acero", "Hada", "Volver pag. 1")
                closemessage
                if (var(VAR_RESULT) == MULTI_B_PRESSED) {
                    setvar(VAR_0x8005, 101)
                } elif (var(VAR_RESULT) == 6) {
                    setvar(VAR_0x8006, 0)
                } else {
                    copyvar(VAR_0x8005, VAR_RESULT)
                    addvar(VAR_0x8005, 12)
                }
        }
    }

    if (var(VAR_0x8005) == 101) {
        msgbox("Entendido, lo dejamos para luego.", MSGBOX_DEFAULT)
        release
        end
    }

    // Abre la pantalla nativa del Recordador con los movimientos del tipo elegido
    special(TeachUniversalTutorMove)
    waitstate

    if (var(VAR_RESULT) == TRUE) {
        msgbox("Listo! Tu Pokemon ha aprendido\nel movimiento.", MSGBOX_DEFAULT)
    } else {
        msgbox("No se ha ensenado ningun ataque.", MSGBOX_DEFAULT)
    }

    release
    end
}



